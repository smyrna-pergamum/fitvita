    <string name="ex_push_up">Liegestütz</string>
    <string name="ex_push_up_steps">Hände unter den Schultern, Körper in einer Linie.\nBrust Richtung Boden senken.\nWieder hochdrücken.</string>
    <string name="ex_knee_push_up">Knie-Liegestütz</string>
    <string name="ex_knee_push_up_steps">Knie auf der Matte, Hände unter den Schultern.\nBrust senken.\nWieder hochdrücken.</string>
    <string name="ex_chair_dip">Stuhl-Dips</string>
    <string name="ex_chair_dip_steps">Hände auf die Kante eines stabilen Stuhls hinter dir.\nEllbogen beugen und den Körper senken.\nArme strecken und hochkommen.</string>
    <string name="ex_biceps_curl">Bizepscurl</string>
    <string name="ex_biceps_curl_steps">Aufrecht stehen, Hanteln seitlich.\nEllbogen beugen und Gewichte heben.\nLangsam senken.</string>
    <string name="ex_shoulder_press">Schulterdrücken</string>
    <string name="ex_shoulder_press_steps">Hanteln auf Schulterhöhe.\nGerade nach oben drücken.\nZurück zu den Schultern senken.</string>
    <string name="ex_lateral_raise">Seitheben</string>
    <string name="ex_lateral_raise_steps">Hanteln seitlich, Ellbogen leicht gebeugt.\nArme seitlich bis Schulterhöhe heben.\nLangsam senken.</string>
    <string name="ex_bent_over_row">Vorgebeugtes Rudern</string>
    <string name="ex_bent_over_row_steps">Mit geradem Rücken nach vorn beugen, Knie locker.\nHanteln zur Hüfte ziehen.\nWieder senken.</string>
    <string name="ex_squat">Kniebeuge</string>
    <string name="ex_squat_steps">Füße schulterbreit.\nNach hinten unten setzen, Brust oben.\nÜber die Fersen hochdrücken.</string>
    <string name="ex_goblet_squat">Goblet Squat</string>
    <string name="ex_goblet_squat_steps">Eine Hantel vor der Brust halten.\nMit geradem Rücken in die Hocke.\nAufstehen.</string>
    <string name="ex_lunge">Ausfallschritt</string>
    <string name="ex_lunge_steps">Großen Schritt nach vorn.\nHinteres Knie Richtung Boden senken.\nZurückdrücken und Bein wechseln.</string>
    <string name="ex_glute_bridge">Glute Bridge</string>
    <string name="ex_glute_bridge_steps">Auf den Rücken, Knie gebeugt.\nHüfte anheben.\nLangsam senken.</string>
    <string name="ex_calf_raise">Wadenheben</string>
    <string name="ex_calf_raise_steps">Aufrecht stehen.\nAuf die Zehenspitzen gehen.\nLangsam senken.</string>
    <string name="ex_wall_sit">Wandsitzen</string>
    <string name="ex_wall_sit_steps">Rücken an die Wand.\nHerunterrutschen, bis die Knie im rechten Winkel sind.\nHalten.</string>
    <string name="ex_plank">Unterarmstütz</string>
    <string name="ex_plank_steps">Unterarme am Boden, Ellbogen unter den Schultern.\nKörper in einer Linie.\nHalten und atmen.</string>
    <string name="ex_side_plank">Seitstütz</string>
    <string name="ex_side_plank_steps">Seitlich auf einen Unterarm legen.\nHüfte in eine gerade Linie heben.\nHalten, dann Seite wechseln.</string>
    <string name="ex_crunch">Crunch</string>
    <string name="ex_crunch_steps">Auf den Rücken, Knie gebeugt.\nSchultern vom Boden heben.\nLangsam senken.</string>
    <string name="ex_leg_raise">Beinheben</string>
    <string name="ex_leg_raise_steps">Auf den Rücken, Beine gestreckt.\nBeine nach oben heben.\nLangsam senken, ohne ins Hohlkreuz zu gehen.</string>
    <string name="ex_bird_dog">Vierfüßlerstand</string>
    <string name="ex_bird_dog_steps">Auf Händen und Knien, Rücken gerade.\nEinen Arm und das andere Bein strecken.\nZurück und Seite wechseln.</string>
    <string name="ex_superman">Superman</string>
    <string name="ex_superman_steps">Bauchlage, Arme nach vorn.\nArme und Beine leicht anheben.\nKurz halten und senken.</string>
    <string name="ex_jumping_jack">Hampelmann</string>
    <string name="ex_jumping_jack_steps">Füße zusammen stehen.\nFüße auseinanderspringen, Arme über den Kopf.\nZurückspringen und wiederholen.</string>
    <string name="ex_high_knees">Kniehebelauf</string>
    <string name="ex_high_knees_steps">Auf der Stelle laufen.\nKnie auf Hüfthöhe heben.\nArme mitschwingen.</string>
    <string name="ex_mountain_climber">Bergsteiger</string>
    <string name="ex_mountain_climber_steps">In den hohen Stütz.\nEin Knie zur Brust ziehen.\nBeine schnell wechseln.</string>
