    <string name="ex_yoga_forward_bend">Sitzende Vorbeuge</string>
    <string name="ex_yoga_forward_bend_steps">Mit gestreckten Beinen sitzen.\nRücken mit erhobenen Armen lang machen.\nSanft nach vorn beugen und halten.</string>
    <string name="ex_yoga_bridge">Brücke</string>
