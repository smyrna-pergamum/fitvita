    <string name="breath_hold">Hold</string>
    <string name="calm_breath">Calm breathing</string>
    <string name="calm_breath_hint">In for 4 s, out for 6 s. Slows the heart and calms the mind.</string>
    <string name="calm_box">Box breathing</string>
    <string name="calm_box_hint">In 4, hold 4, out 4, hold 4. Clears the head before a task.</string>
    <string name="calm_478">4-7-8 breathing</string>
    <string name="calm_478_hint">In 4, hold 7, out 8. Helps you fall asleep.</string>
    <string name="calm_body_scan">Body scan</string>
    <string name="calm_body_scan_hint">Move your attention slowly through the body and let each part relax.</string>
    <string name="calm_grounding">5-4-3-2-1 grounding</string>
    <string name="calm_grounding_hint">Use your senses to come back to the present moment.</string>
    <string name="calm_relax">Muscle relaxation</string>
    <string name="calm_relax_hint">Tense each muscle group for 5 seconds, then let it go.</string>
    <string name="calm_gratitude">Gratitude moment</string>
    <string name="calm_gratitude_hint">Think of three good things. A warm way to start or end the day.</string>
    <string name="scan_1">Sit or lie comfortably. Close your eyes and breathe slowly.</string>
    <string name="scan_2">Notice your feet and legs. Let them grow heavy and soft.</string>
    <string name="scan_3">Feel your belly rise and fall. Let your lower back relax.</string>
    <string name="scan_4">Let your shoulders drop. Arms and hands become heavy.</string>
    <string name="scan_5">Soften your face: forehead, eyes, jaw. Unclench your teeth.</string>
    <string name="scan_6">Feel your whole body at rest. Stay here for a few breaths.</string>
    <string name="ground_1">Look around and name 5 things you can see.</string>
    <string name="ground_2">Notice 4 things you can touch or feel.</string>
    <string name="ground_3">Listen for 3 sounds around you.</string>
    <string name="ground_4">Find 2 things you can smell.</string>
    <string name="ground_5">Notice 1 thing you can taste. Then take a slow, deep breath.</string>
    <string name="relax_1">Make fists, squeeze for 5 seconds… and let go.</string>
    <string name="relax_2">Pull your shoulders up to your ears… hold… and drop them.</string>
    <string name="relax_3">Scrunch your face tight… hold… and soften it.</string>
    <string name="relax_4">Tighten your belly… hold… and breathe out as it relaxes.</string>
    <string name="relax_5">Press your legs together and point your toes… hold… release.</string>
    <string name="relax_6">Let your whole body go loose and heavy. Breathe slowly.</string>
    <string name="thanks_1">Think of one person you are thankful for today.</string>
    <string name="thanks_2">Remember one small moment that made you smile.</string>
    <string name="thanks_3">Name one thing your body did well for you today.</string>
    <string name="med_morning">Morning calm</string>
    <string name="med_morning_hint">Start the day clear and grateful, with birdsong.</string>
    <string name="med_stress">Stress relief</string>
    <string name="med_stress_hint">Come back to the moment, then slow your breathing. With flowing water.</string>
    <string name="med_focus">Focus</string>
    <string name="med_focus_hint">Box breathing and a body scan before work or study. With forest sounds.</string>
    <string name="med_sleep">Sleep wind-down</string>
    <string name="med_sleep_hint">4-7-8 breathing, muscle relaxation and a body scan. With soft rain.</string>
    <string name="ex_donkey_kick">Donkey kick</string>
    <string name="ex_donkey_kick_steps">On hands and knees, back flat.\nKick one leg up, knee bent, sole to the ceiling.\nSqueeze the glute, lower slowly, switch sides.</string>
    <string name="ex_single_leg_bridge">Single-leg bridge</string>
    <string name="ex_single_leg_bridge_steps">Lie on your back, one knee bent, the other leg straight.\nPush through the heel and lift the hips.\nLower slowly; switch legs halfway.</string>
    <string name="ex_sumo_squat">Sumo squat</string>
    <string name="ex_sumo_squat_steps">Feet wide, toes turned out, hands on hips.\nBend the knees and sit straight down.\nPush up through the heels and squeeze the glutes.</string>
    <string name="ex_side_lunge">Side lunge</string>
    <string name="ex_side_lunge_steps">Stand tall, hands on hips.\nStep wide to one side and bend that knee; the other leg stays straight.\nPush back to the middle; alternate sides.</string>
    <string name="ex_jump_squat">Jump squat</string>
    <string name="ex_jump_squat_steps">Squat down with the arms back.\nJump up explosively, arms overhead.\nLand softly on bent knees and go straight into the next one.</string>
    <string name="ex_bicycle_crunch">Bicycle crunch</string>
    <string name="ex_bicycle_crunch_steps">Lie on your back, hands behind your head, shoulders up.\nBring one knee in and turn the opposite elbow towards it.\nSwitch sides in a slow pedalling motion.</string>
    <string name="ex_russian_twist">Russian twist</string>
    <string name="ex_russian_twist_steps">Sit, lean back a little, feet lifted or on the floor.\nTurn your chest and hands to one side.\nTurn to the other side; keep the back long.</string>
    <string name="ex_flutter_kick">Flutter kicks</string>
    <string name="ex_flutter_kick_steps">Lie on your back, hands under your hips.\nLift both legs a little off the floor.\nKick them up and down in small, quick moves.</string>
    <string name="ex_dumbbell_rdl">Dumbbell deadlift</string>
    <string name="ex_dumbbell_rdl_steps">Stand with a dumbbell in each hand, knees soft.\nPush the hips back and lower the weights along the legs, back flat.\nStand up by squeezing the glutes.</string>
    <string name="ex_triceps_extension">Overhead triceps extension</string>
    <string name="ex_triceps_extension_steps">Hold one dumbbell with both hands above your head.\nBend the elbows and lower it behind your head.\nStraighten the arms again; elbows point up.</string>
    <string name="ex_pilates_double_leg">Double leg stretch</string>
    <string name="ex_pilates_double_leg_steps">Lie on your back, knees to chest, head and shoulders up.\nReach the arms back and stretch both legs long.\nCircle the arms round and hug the knees again.</string>
    <string name="ex_pilates_scissors">Scissors</string>
    <string name="ex_pilates_scissors_steps">Lie on your back, head and shoulders up, legs straight up.\nLower one leg while holding the other towards you.\nSwitch legs with two small pulses.</string>
    <string name="ex_pilates_leg_pull">Leg pull front</string>
    <string name="ex_pilates_leg_pull_steps">Start in a high plank, body in one line.\nLift one straight leg without moving the hips.\nLower it and switch legs.</string>
    <string name="ex_pilates_spine_stretch">Spine stretch forward</string>
    <string name="ex_pilates_spine_stretch_steps">Sit tall, legs straight and apart, arms forward.\nBreathe out and round forward, one vertebra at a time.\nRoll back up to sitting tall.</string>
    <string name="ex_pilates_shoulder_bridge">Shoulder bridge</string>
    <string name="ex_pilates_shoulder_bridge_steps">Lift the hips into a bridge, feet flat.\nKick one straight leg up to the ceiling.\nLower it with control; keep the hips high, then switch.</string>
    <string name="ex_pilates_rolling">Rolling like a ball</string>
    <string name="ex_pilates_rolling_steps">Sit and hug your shins, feet off the floor, back round.\nRoll back onto your shoulder blades.\nRoll up again and balance; don\'t roll onto your neck.</string>
