    <string name="ex_pilates_hundred">The Hundred</string>
    <string name="ex_pilates_hundred_steps">Lie on your back, legs lifted, head and shoulders up.\nArms long beside you, pump them up and down.\nBreathe in for 5 pumps, out for 5.</string>
    <string name="ex_pilates_roll_up">Roll up</string>
    <string name="ex_pilates_roll_up_steps">Lie on your back, arms overhead.\nRoll up slowly, one vertebra at a time, reaching for your toes.\nRoll back down with control.</string>
    <string name="ex_pilates_single_leg">Single leg stretch</string>
    <string name="ex_pilates_single_leg_steps">Lie on your back, head and shoulders up.\nPull one knee in, stretch the other leg long.\nSwitch legs smoothly.</string>
    <string name="ex_pilates_leg_circle">Leg circles</string>
    <string name="ex_pilates_leg_circle_steps">Lie on your back, one leg up to the ceiling.\nDraw small circles with that leg, hips still.\nChange direction, then switch legs.</string>
    <string name="ex_pilates_swimming">Swimming</string>
    <string name="ex_pilates_swimming_steps">Lie face down, arms and legs long.\nLift arms, chest and legs a little.\nFlutter opposite arm and leg quickly.</string>
    <string name="ex_pilates_teaser">Teaser</string>
    <string name="ex_pilates_teaser_steps">Lie on your back, legs lifted at an angle.\nRoll up into a V, arms reaching to your feet.\nHold briefly and roll down slowly.</string>
