    <string name="ex_push_up">Push-up</string>
    <string name="ex_push_up_steps">Hands under shoulders, body in one straight line.\nLower your chest towards the floor.\nPush back up.</string>
    <string name="ex_knee_push_up">Knee push-up</string>
    <string name="ex_knee_push_up_steps">Knees on the mat, hands under shoulders.\nLower your chest.\nPush back up.</string>
    <string name="ex_chair_dip">Chair dip</string>
    <string name="ex_chair_dip_steps">Hands on the edge of a stable chair behind you.\nBend your elbows to lower your body.\nStraighten your arms to rise.</string>
    <string name="ex_biceps_curl">Biceps curl</string>
    <string name="ex_biceps_curl_steps">Stand tall, dumbbells at your sides.\nBend your elbows and lift the weights.\nLower slowly.</string>
    <string name="ex_shoulder_press">Shoulder press</string>
    <string name="ex_shoulder_press_steps">Dumbbells at shoulder height.\nPress them straight up.\nLower back to the shoulders.</string>
    <string name="ex_lateral_raise">Lateral raise</string>
    <string name="ex_lateral_raise_steps">Dumbbells at your sides, slight bend in the elbows.\nRaise your arms out to shoulder height.\nLower slowly.</string>
    <string name="ex_bent_over_row">Bent-over row</string>
    <string name="ex_bent_over_row_steps">Lean forward with a flat back, knees soft.\nPull the dumbbells towards your hips.\nLower them again.</string>
    <string name="ex_squat">Squat</string>
    <string name="ex_squat_steps">Feet shoulder-width apart.\nSit back and down, chest up.\nPush through your heels to stand.</string>
    <string name="ex_goblet_squat">Goblet squat</string>
    <string name="ex_goblet_squat_steps">Hold one dumbbell at your chest.\nSquat down, back straight.\nStand up.</string>
    <string name="ex_lunge">Lunge</string>
    <string name="ex_lunge_steps">Take a big step forward.\nLower your back knee towards the floor.\nPush back and switch legs.</string>
    <string name="ex_glute_bridge">Glute bridge</string>
    <string name="ex_glute_bridge_steps">Lie on your back, knees bent.\nLift your hips.\nLower slowly.</string>
    <string name="ex_calf_raise">Calf raise</string>
    <string name="ex_calf_raise_steps">Stand tall.\nRise onto your toes.\nLower slowly.</string>
    <string name="ex_wall_sit">Wall sit</string>
    <string name="ex_wall_sit_steps">Back against a wall.\nSlide down until your knees are bent at a right angle.\nHold.</string>
    <string name="ex_plank">Plank</string>
    <string name="ex_plank_steps">Forearms on the floor, elbows under shoulders.\nBody in one straight line.\nHold and breathe.</string>
    <string name="ex_side_plank">Side plank</string>
    <string name="ex_side_plank_steps">Lie on your side on one forearm.\nLift your hips into a straight line.\nHold, then switch sides.</string>
    <string name="ex_crunch">Crunch</string>
    <string name="ex_crunch_steps">Lie on your back, knees bent.\nLift your shoulders off the floor.\nLower slowly.</string>
    <string name="ex_leg_raise">Leg raise</string>
    <string name="ex_leg_raise_steps">Lie on your back, legs straight.\nRaise your legs up.\nLower slowly without arching your back.</string>
    <string name="ex_bird_dog">Bird dog</string>
    <string name="ex_bird_dog_steps">On hands and knees, back flat.\nStretch one arm and the opposite leg.\nReturn and switch sides.</string>
    <string name="ex_superman">Superman</string>
    <string name="ex_superman_steps">Lie face down, arms forward.\nLift arms and legs a little.\nHold briefly and lower.</string>
    <string name="ex_jumping_jack">Jumping jack</string>
    <string name="ex_jumping_jack_steps">Stand with feet together.\nJump feet apart, arms overhead.\nJump back and repeat.</string>
    <string name="ex_high_knees">High knees</string>
    <string name="ex_high_knees_steps">Run on the spot.\nLift your knees to hip height.\nSwing your arms.</string>
    <string name="ex_mountain_climber">Mountain climber</string>
    <string name="ex_mountain_climber_steps">Start in a high plank.\nPull one knee towards your chest.\nSwitch legs quickly.</string>
