    <string name="ex_yoga_child">Postura del niño</string>
    <string name="ex_yoga_child_steps">Arrodíllate y siéntate sobre los talones.\nInclínate hacia delante, frente al suelo.\nEstira los brazos al frente y relájate.</string>
    <string name="ex_yoga_forward_bend">Pinza sentada</string>
