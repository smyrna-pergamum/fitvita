    <string name="ex_push_up">Flexión</string>
    <string name="ex_push_up_steps">Manos bajo los hombros, cuerpo en línea recta.\nBaja el pecho hacia el suelo.\nEmpuja hacia arriba.</string>
    <string name="ex_knee_push_up">Flexión de rodillas</string>
    <string name="ex_knee_push_up_steps">Rodillas en la esterilla, manos bajo los hombros.\nBaja el pecho.\nEmpuja hacia arriba.</string>
    <string name="ex_chair_dip">Fondos en silla</string>
    <string name="ex_chair_dip_steps">Manos en el borde de una silla estable detrás de ti.\nDobla los codos para bajar.\nEstira los brazos para subir.</string>
    <string name="ex_biceps_curl">Curl de bíceps</string>
    <string name="ex_biceps_curl_steps">De pie, mancuernas a los lados.\nDobla los codos y sube las pesas.\nBaja despacio.</string>
    <string name="ex_shoulder_press">Press de hombros</string>
    <string name="ex_shoulder_press_steps">Mancuernas a la altura de los hombros.\nEmpújalas hacia arriba.\nBájalas a los hombros.</string>
    <string name="ex_lateral_raise">Elevación lateral</string>
    <string name="ex_lateral_raise_steps">Mancuernas a los lados, codos algo doblados.\nSube los brazos hasta la altura de los hombros.\nBaja despacio.</string>
    <string name="ex_bent_over_row">Remo inclinado</string>
    <string name="ex_bent_over_row_steps">Inclínate con la espalda recta, rodillas suaves.\nTira de las mancuernas hacia la cadera.\nBájalas de nuevo.</string>
    <string name="ex_squat">Sentadilla</string>
    <string name="ex_squat_steps">Pies al ancho de los hombros.\nSiéntate hacia atrás y abajo, pecho arriba.\nEmpuja con los talones para subir.</string>
    <string name="ex_goblet_squat">Sentadilla goblet</string>
    <string name="ex_goblet_squat_steps">Sujeta una mancuerna en el pecho.\nBaja con la espalda recta.\nLevántate.</string>
    <string name="ex_lunge">Zancada</string>
    <string name="ex_lunge_steps">Da un paso grande hacia delante.\nBaja la rodilla de atrás hacia el suelo.\nVuelve y cambia de pierna.</string>
    <string name="ex_glute_bridge">Puente de glúteos</string>
    <string name="ex_glute_bridge_steps">Boca arriba, rodillas dobladas.\nLevanta la cadera.\nBaja despacio.</string>
    <string name="ex_calf_raise">Elevación de talones</string>
    <string name="ex_calf_raise_steps">De pie y recto.\nSube de puntillas.\nBaja despacio.</string>
    <string name="ex_wall_sit">Sentadilla en pared</string>
    <string name="ex_wall_sit_steps">Espalda contra la pared.\nDesliza hasta que las rodillas formen un ángulo recto.\nMantén.</string>
    <string name="ex_plank">Plancha</string>
    <string name="ex_plank_steps">Antebrazos en el suelo, codos bajo los hombros.\nCuerpo en línea recta.\nMantén y respira.</string>
    <string name="ex_side_plank">Plancha lateral</string>
    <string name="ex_side_plank_steps">De lado sobre un antebrazo.\nSube la cadera en línea recta.\nMantén y cambia de lado.</string>
    <string name="ex_crunch">Abdominal</string>
    <string name="ex_crunch_steps">Boca arriba, rodillas dobladas.\nLevanta los hombros del suelo.\nBaja despacio.</string>
    <string name="ex_leg_raise">Elevación de piernas</string>
    <string name="ex_leg_raise_steps">Boca arriba, piernas rectas.\nSube las piernas.\nBaja despacio sin arquear la espalda.</string>
    <string name="ex_bird_dog">Bird dog</string>
    <string name="ex_bird_dog_steps">A cuatro patas, espalda recta.\nEstira un brazo y la pierna contraria.\nVuelve y cambia de lado.</string>
    <string name="ex_superman">Superman</string>
    <string name="ex_superman_steps">Boca abajo, brazos al frente.\nLevanta un poco brazos y piernas.\nMantén un momento y baja.</string>
    <string name="ex_jumping_jack">Saltos de tijera</string>
    <string name="ex_jumping_jack_steps">De pie con los pies juntos.\nSalta abriendo los pies, brazos arriba.\nVuelve y repite.</string>
    <string name="ex_high_knees">Rodillas arriba</string>
    <string name="ex_high_knees_steps">Corre en el sitio.\nSube las rodillas a la altura de la cadera.\nMueve los brazos.</string>
    <string name="ex_mountain_climber">Escalador</string>
    <string name="ex_mountain_climber_steps">Empieza en plancha alta.\nLleva una rodilla al pecho.\nCambia de pierna rápido.</string>
