    <string name="ex_push_up">Pompe</string>
    <string name="ex_push_up_steps">Mains sous les épaules, corps bien droit.\nDescends la poitrine vers le sol.\nRemonte en poussant.</string>
    <string name="ex_knee_push_up">Pompe sur les genoux</string>
    <string name="ex_knee_push_up_steps">Genoux sur le tapis, mains sous les épaules.\nDescends la poitrine.\nRemonte en poussant.</string>
    <string name="ex_chair_dip">Dips sur chaise</string>
    <string name="ex_chair_dip_steps">Mains sur le bord d’une chaise stable derrière toi.\nPlie les coudes pour descendre.\nTends les bras pour remonter.</string>
    <string name="ex_biceps_curl">Curl biceps</string>
    <string name="ex_biceps_curl_steps">Debout, haltères le long du corps.\nPlie les coudes et monte les poids.\nRedescends lentement.</string>
    <string name="ex_shoulder_press">Développé épaules</string>
    <string name="ex_shoulder_press_steps">Haltères à hauteur des épaules.\nPousse-les vers le haut.\nRedescends aux épaules.</string>
    <string name="ex_lateral_raise">Élévations latérales</string>
    <string name="ex_lateral_raise_steps">Haltères le long du corps, coudes légèrement fléchis.\nMonte les bras sur les côtés jusqu’aux épaules.\nRedescends lentement.</string>
    <string name="ex_bent_over_row">Rowing penché</string>
    <string name="ex_bent_over_row_steps">Penche-toi dos plat, genoux souples.\nTire les haltères vers les hanches.\nRedescends-les.</string>
    <string name="ex_squat">Squat</string>
    <string name="ex_squat_steps">Pieds à largeur d’épaules.\nAssieds-toi vers l’arrière, poitrine haute.\nPousse sur les talons pour remonter.</string>
    <string name="ex_goblet_squat">Goblet squat</string>
    <string name="ex_goblet_squat_steps">Tiens un haltère contre la poitrine.\nDescends dos droit.\nRemonte.</string>
    <string name="ex_lunge">Fente</string>
    <string name="ex_lunge_steps">Fais un grand pas en avant.\nDescends le genou arrière vers le sol.\nReviens et change de jambe.</string>
    <string name="ex_glute_bridge">Pont fessier</string>
    <string name="ex_glute_bridge_steps">Sur le dos, genoux pliés.\nMonte les hanches.\nRedescends lentement.</string>
    <string name="ex_calf_raise">Montées sur pointes</string>
    <string name="ex_calf_raise_steps">Tiens-toi droit.\nMonte sur la pointe des pieds.\nRedescends lentement.</string>
    <string name="ex_wall_sit">Chaise contre le mur</string>
    <string name="ex_wall_sit_steps">Dos contre un mur.\nGlisse jusqu’à ce que les genoux forment un angle droit.\nTiens la position.</string>
    <string name="ex_plank">Gainage</string>
    <string name="ex_plank_steps">Avant-bras au sol, coudes sous les épaules.\nCorps bien droit.\nTiens et respire.</string>
    <string name="ex_side_plank">Gainage latéral</string>
    <string name="ex_side_plank_steps">Sur le côté, appui sur un avant-bras.\nMonte les hanches en ligne droite.\nTiens puis change de côté.</string>
    <string name="ex_crunch">Crunch</string>
    <string name="ex_crunch_steps">Sur le dos, genoux pliés.\nDécolle les épaules du sol.\nRedescends lentement.</string>
    <string name="ex_leg_raise">Relevés de jambes</string>
    <string name="ex_leg_raise_steps">Sur le dos, jambes tendues.\nLève les jambes.\nRedescends lentement sans cambrer le dos.</string>
    <string name="ex_bird_dog">Bird dog</string>
    <string name="ex_bird_dog_steps">À quatre pattes, dos plat.\nTends un bras et la jambe opposée.\nReviens et change de côté.</string>
    <string name="ex_superman">Superman</string>
    <string name="ex_superman_steps">Allongé sur le ventre, bras devant.\nSoulève un peu bras et jambes.\nTiens un instant et redescends.</string>
    <string name="ex_jumping_jack">Jumping jack</string>
    <string name="ex_jumping_jack_steps">Debout, pieds joints.\nSaute pieds écartés, bras au-dessus de la tête.\nReviens et recommence.</string>
    <string name="ex_high_knees">Montées de genoux</string>
    <string name="ex_high_knees_steps">Cours sur place.\nMonte les genoux à hauteur des hanches.\nBalance les bras.</string>
    <string name="ex_mountain_climber">Mountain climber</string>
    <string name="ex_mountain_climber_steps">Commence en planche bras tendus.\nRamène un genou vers la poitrine.\nAlterne vite les jambes.</string>
