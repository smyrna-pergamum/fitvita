    <string name="ex_yoga_mountain">Posture de la montagne</string>
    <string name="ex_yoga_mountain_steps">Debout, pieds joints.\nLève les bras au-dessus de la tête.\nRespire calmement et tiens.</string>
    <string name="ex_yoga_tree">Posture de l’arbre</string>
    <string name="ex_yoga_tree_steps">Tiens-toi sur une jambe.\nPose l’autre pied sur le mollet ou la cuisse, pas sur le genou.\nBras levés, tiens puis change.</string>
    <string name="ex_yoga_warrior">Guerrier II</string>
    <string name="ex_yoga_warrior_steps">Écarte largement les pieds.\nPlie le genou avant au-dessus de la cheville.\nTends les bras et tiens.</string>
    <string name="ex_yoga_triangle">Triangle</string>
    <string name="ex_yoga_triangle_steps">Pieds écartés, jambes tendues.\nPenche-toi sur le côté et descends une main vers le tibia.\nLève l’autre bras et tiens.</string>
    <string name="ex_yoga_downward_dog">Chien tête en bas</string>
    <string name="ex_yoga_downward_dog_steps">Commence à quatre pattes.\nMonte les hanches vers le haut et l’arrière.\nPousse les talons vers le sol et tiens.</string>
    <string name="ex_yoga_cobra">Cobra</string>
    <string name="ex_yoga_cobra_steps">Sur le ventre, mains sous les épaules.\nSoulève doucement la poitrine.\nGarde les hanches au sol et tiens.</string>
    <string name="ex_yoga_child">Posture de l’enfant</string>
    <string name="ex_yoga_child_steps">À genoux, assieds-toi sur les talons.\nPenche-toi en avant, front au sol.\nTends les bras devant et relâche.</string>
    <string name="ex_yoga_forward_bend">Pince assise</string>
    <string name="ex_yoga_forward_bend_steps">Assieds-toi jambes tendues.\nAllonge le dos, bras levés.\nPenche-toi doucement en avant et tiens.</string>
    <string name="ex_yoga_bridge">Pont</string>
    <string name="ex_yoga_bridge_steps">Sur le dos, genoux pliés.\nMonte les hanches.\nRespire et tiens.</string>
    <string name="ex_yoga_savasana">Posture de relaxation</string>
    <string name="ex_yoga_savasana_steps">Sur le dos, bras le long du corps.\nFerme les yeux.\nRelâche chaque muscle et respire lentement.</string>
