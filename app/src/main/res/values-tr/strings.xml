    <string name="ex_pilates_hundred">Yüzlük (Hundred)</string>
    <string name="ex_pilates_hundred_steps">Sırt üstü uzan, bacaklar havada, baş ve omuzlar kalkık.\nKollar yanda uzun, aşağı yukarı küçük vuruşlar yap.\n5 vuruş nefes al, 5 vuruş ver.</string>
    <string name="ex_pilates_roll_up">Roll up (yuvarlanarak kalkış)</string>
    <string name="ex_pilates_roll_up_steps">Sırt üstü uzan, kollar başının üstünde.\nOmurlarını tek tek kaldırarak yavaşça doğrul, ayak parmaklarına uzan.\nKontrollü şekilde geri yuvarlan.</string>
    <string name="ex_pilates_single_leg">Tek bacak esnetme</string>
    <string name="ex_pilates_single_leg_steps">Sırt üstü uzan, baş ve omuzlar kalkık.\nBir dizini göğsüne çek, diğer bacağı uzat.\nBacakları akıcı şekilde değiştir.</string>
    <string name="ex_pilates_leg_circle">Bacak çevirme</string>
    <string name="ex_pilates_leg_circle_steps">Sırt üstü uzan, bir bacağını tavana kaldır.\nKalça sabit, bu bacakla küçük daireler çiz.\nYönü değiştir, sonra bacağı değiştir.</string>
    <string name="ex_pilates_swimming">Yüzme</string>
    <string name="ex_pilates_swimming_steps">Yüz üstü uzan, kollar ve bacaklar uzun.\nKolları, göğsü ve bacakları biraz kaldır.\nÇapraz kol ve bacağı hızlıca çırp.</string>
    <string name="ex_pilates_teaser">Teaser (V oturuş)</string>
    <string name="ex_pilates_teaser_steps">Sırt üstü uzan, bacaklar açılı şekilde havada.\nKollar ayaklara uzanarak V şekline yuvarlan.\nKısa tut ve yavaşça geri in.</string>
