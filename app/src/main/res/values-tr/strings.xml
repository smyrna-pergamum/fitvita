    <string name="ex_yoga_triangle_steps">Ayaklar geniş, bacaklar düz.\nYana uzan, bir elini kaval kemiğine indir.\nDiğer kolu kaldır ve bekle.</string>
    <string name="ex_yoga_downward_dog">Aşağı bakan köpek</string>
    <string name="ex_yoga_downward_dog_steps">Eller ve dizler üzerinde başla.\nKalçanı yukarı ve geriye kaldır.\nTopuklarını yere doğru bastır ve bekle.</string>
    <string name="ex_yoga_cobra">Kobra</string>
    <string name="ex_yoga_cobra_steps">Yüzüstü uzan, eller omuz altında.\nGöğsünü yavaşça kaldır.\nKalça yerde kalsın, bekle.</string>
    <string name="ex_yoga_child">Çocuk duruşu</string>
    <string name="ex_yoga_child_steps">Diz çök ve topuklarının üzerine otur.\nÖne katlan, alnını yere koy.\nKollarını öne uzat ve gevşe.</string>
    <string name="ex_yoga_forward_bend">Oturarak öne eğilme</string>
    <string name="ex_yoga_forward_bend_steps">Bacaklar düz otur.\nKollar yukarı, sırtını uzat.\nYavaşça öne katlan ve bekle.</string>
    <string name="ex_yoga_bridge">Köprü duruşu</string>
    <string name="ex_yoga_bridge_steps">Sırtüstü uzan, dizler bükük.\nKalçanı kaldır.\nNefes al ve bekle.</string>
    <string name="ex_yoga_savasana">Rahatlama duruşu</string>
    <string name="ex_yoga_savasana_steps">Sırtüstü uzan, kollar yanlarda.\nGözlerini kapat.\nTüm kaslarını gevşet, yavaş nefes al.</string>
