    <string name="calm_breath">Sakin nefes</string>
    <string name="calm_breath_hint">4 sn nefes al, 6 sn ver. Kalbi yavaşlatır, zihni sakinleştirir.</string>
    <string name="calm_box">Kare nefes</string>
    <string name="calm_box_hint">4 al, 4 tut, 4 ver, 4 tut. Bir işe başlamadan zihni toparlar.</string>
    <string name="calm_478">4-7-8 nefesi</string>
    <string name="calm_478_hint">4 al, 7 tut, 8 ver. Uykuya geçişi kolaylaştırır.</string>
    <string name="calm_body_scan">Beden taraması</string>
    <string name="calm_body_scan_hint">Dikkatini yavaşça bedeninde gezdir, her bölgeyi gevşet.</string>
    <string name="calm_grounding">5-4-3-2-1 topraklanma</string>
    <string name="calm_grounding_hint">Duyularınla şimdiki ana geri dön.</string>
    <string name="calm_relax">Kas gevşetme</string>
    <string name="calm_relax_hint">Her kas grubunu 5 saniye sık, sonra bırak.</string>
    <string name="calm_gratitude">Şükran anı</string>
    <string name="calm_gratitude_hint">Üç güzel şeyi düşün. Güne başlamanın ya da bitirmenin sıcak bir yolu.</string>
    <string name="scan_1">Rahatça otur ya da uzan. Gözlerini kapat, yavaşça nefes al.</string>
    <string name="scan_2">Ayaklarını ve bacaklarını fark et. Ağırlaşıp yumuşamalarına izin ver.</string>
    <string name="scan_3">Karnının inip kalktığını hisset. Belini gevşet.</string>
    <string name="scan_4">Omuzlarını bırak. Kolların ve ellerin ağırlaşsın.</string>
    <string name="scan_5">Yüzünü yumuşat: alın, gözler, çene. Dişlerini sıkma.</string>
    <string name="scan_6">Tüm bedenini dinlenirken hisset. Birkaç nefes burada kal.</string>
    <string name="ground_1">Etrafına bak ve görebildiğin 5 şeyi say.</string>
    <string name="ground_2">Dokunabildiğin ya da hissettiğin 4 şeyi fark et.</string>
    <string name="ground_3">Etrafındaki 3 sesi dinle.</string>
    <string name="ground_4">Kokusunu alabildiğin 2 şey bul.</string>
    <string name="ground_5">Tadını alabildiğin 1 şeyi fark et. Sonra yavaş ve derin bir nefes al.</string>
    <string name="relax_1">Yumruk yap, 5 saniye sık… ve bırak.</string>
    <string name="relax_2">Omuzlarını kulaklarına doğru kaldır… tut… ve bırak.</string>
    <string name="relax_3">Yüzünü buruştur… tut… ve yumuşat.</string>
    <string name="relax_4">Karnını sık… tut… ve gevşerken nefes ver.</string>
    <string name="relax_5">Bacaklarını birbirine bastır, ayak parmaklarını uzat… tut… bırak.</string>
    <string name="relax_6">Tüm bedenini gevşek ve ağır bırak. Yavaşça nefes al.</string>
    <string name="thanks_1">Bugün minnettar olduğun bir kişiyi düşün.</string>
    <string name="thanks_2">Seni gülümseten küçük bir anı hatırla.</string>
    <string name="thanks_3">Bedeninin bugün senin için iyi yaptığı bir şeyi söyle.</string>
    <string name="med_morning">Sabah sakinliği</string>
    <string name="med_morning_hint">Güne berrak ve minnettar başla, kuş sesleriyle.</string>
    <string name="med_stress">Stres giderme</string>
    <string name="med_stress_hint">Ana dön, sonra nefesini yavaşlat. Akan su sesiyle.</string>
    <string name="med_focus">Odaklanma</string>
    <string name="med_focus_hint">İş ya da ders öncesi kare nefes ve beden taraması. Orman sesiyle.</string>
    <string name="med_sleep">Uykuya hazırlık</string>
    <string name="med_sleep_hint">4-7-8 nefesi, kas gevşetme ve beden taraması. Yağmur sesiyle.</string>
    <string name="ex_donkey_kick">Eşek tekmesi</string>
    <string name="ex_donkey_kick_steps">Eller ve dizler üstünde, sırt düz.\nBir bacağını dizin bükük, taban tavana bakacak şekilde kaldır.\nKalçanı sık, yavaşça indir, taraf değiştir.</string>
    <string name="ex_single_leg_bridge">Tek bacak köprü</string>
    <string name="ex_single_leg_bridge_steps">Sırt üstü uzan, bir diz bükük, diğer bacak düz.\nTopuktan it ve kalçanı kaldır.\nYavaşça indir; yarıda bacak değiştir.</string>
    <string name="ex_sumo_squat">Sumo squat</string>
    <string name="ex_sumo_squat_steps">Ayaklar geniş, parmaklar dışa dönük, eller belde.\nDizleri bük ve dik şekilde aşağı otur.\nTopuklardan it, kalkarken kalçanı sık.</string>
    <string name="ex_side_lunge">Yan hamle</string>
    <string name="ex_side_lunge_steps">Dik dur, eller belde.\nBir yana geniş adım at ve o dizi bük; diğer bacak düz kalsın.\nOrtaya geri it; taraf değiştir.</string>
    <string name="ex_jump_squat">Zıplamalı squat</string>
    <string name="ex_jump_squat_steps">Kollar geride, squat pozisyonuna in.\nKollar yukarıda, güçlü şekilde zıpla.\nBükük dizlerle yumuşak in ve hemen tekrarla.</string>
    <string name="ex_bicycle_crunch">Bisiklet mekik</string>
    <string name="ex_bicycle_crunch_steps">Sırt üstü uzan, eller başın arkasında, omuzlar kalkık.\nBir dizini çek, karşı dirseği ona doğru döndür.\nYavaş pedal çevirir gibi taraf değiştir.</string>
    <string name="ex_russian_twist">Rus dönüşü</string>
    <string name="ex_russian_twist_steps">Otur, biraz geriye yaslan, ayaklar havada ya da yerde.\nGöğsünü ve ellerini bir yana döndür.\nDiğer yana dön; sırtını uzun tut.</string>
    <string name="ex_flutter_kick">Makas tekmesi</string>
    <string name="ex_flutter_kick_steps">Sırt üstü uzan, ellerini kalçanın altına koy.\nİki bacağını yerden biraz kaldır.\nKüçük ve hızlı hareketlerle aşağı yukarı çırp.</string>
    <string name="ex_dumbbell_rdl">Dambıl deadlift</string>
    <string name="ex_dumbbell_rdl_steps">Her elinde bir dambıl, dizler hafif bükük dur.\nKalçanı geriye it, ağırlıkları bacak boyunca indir, sırt düz.\nKalçanı sıkarak doğrul.</string>
    <string name="ex_triceps_extension">Baş üstü triceps</string>
    <string name="ex_triceps_extension_steps">Tek dambılı iki elinle başının üstünde tut.\nDirsekleri bük ve ağırlığı başının arkasına indir.\nKolları tekrar düzelt; dirsekler yukarı baksın.</string>
    <string name="ex_pilates_double_leg">Çift bacak esnetme</string>
    <string name="ex_pilates_double_leg_steps">Sırt üstü, dizler göğüste, baş ve omuzlar kalkık.\nKolları geriye uzat, iki bacağı da uzat.\nKolları çevirerek dizlere geri sarıl.</string>
    <string name="ex_pilates_scissors">Makas</string>
    <string name="ex_pilates_scissors_steps">Sırt üstü, baş ve omuzlar kalkık, bacaklar yukarıda düz.\nBir bacağı indirirken diğerini kendine doğru tut.\nİki küçük hamleyle bacak değiştir.</string>
    <string name="ex_pilates_leg_pull">Önden bacak çekme</string>
    <string name="ex_pilates_leg_pull_steps">Yüksek plankta başla, vücut tek çizgide.\nKalçayı oynatmadan bir bacağını düz kaldır.\nİndir ve bacak değiştir.</string>
    <string name="ex_pilates_spine_stretch">Omurga esnetme</string>
    <string name="ex_pilates_spine_stretch_steps">Dik otur, bacaklar düz ve açık, kollar önde.\nNefes vererek omur omur öne doğru yuvarlan.\nYavaşça dik oturuşa geri gel.</string>
    <string name="ex_pilates_shoulder_bridge">Omuz köprüsü</string>
    <string name="ex_pilates_shoulder_bridge_steps">Kalçayı köprüye kaldır, ayaklar yerde.\nBir bacağını düz şekilde tavana kaldır.\nKontrollü indir; kalça yüksek kalsın, sonra değiştir.</string>
    <string name="ex_pilates_rolling">Top gibi yuvarlanma</string>
    <string name="ex_pilates_rolling_steps">Otur, kaval kemiklerine sarıl, ayaklar havada, sırt yuvarlak.\nKürek kemiklerine kadar geriye yuvarlan.\nTekrar yuvarlanıp dengede kal; boynuna kadar gitme.</string>
